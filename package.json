{
  "name": "nonprofit-manager",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "contracts",
    "backend",
    "frontend",
    "e2e"
  ],
  "scripts": {
    "audit": "npm audit --workspaces --include-workspace-root --audit-level=moderate",
    "audit:prod": "npm audit --omit=dev --workspaces --include-workspace-root --audit-level=moderate",
    "build": "make build",
    "clean-local": "make clean-local",
    "knip": "knip --config knip.json --include files,dependencies,unlisted,unresolved,binaries",
    "lint": "make lint",
    "sbom": "npm sbom --sbom-format cyclonedx",
    "test": "make test",
    "typecheck": "make typecheck"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "@simplewebauthn/server": "^13.3.3",
    "@vitest/mocker": "^4.1.12",
    "ajv": "^6.14.0",
    "axios": "^1.20.0",
    "body-parser": "^2.4.0",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^2.0.0": "2.1.7",
    "browserslist": "^4.29.4",
    "compression": "^1.8.2",
    "dompurify": "^3.4.17",
    "exceljs": {
      ".": "4.4.0",
      "uuid": "11.1.1"
    },
    "flatted": "^3.4.2",
    "follow-redirects": "^1.16.1",
    "handlebars": "^4.7.10",
    "ip-address": "^10.7.4",
    "js-yaml": "^3.15.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "path-to-regexp": "^8.4.0",
    "postcss": "^8.5.15",
    "proxy-addr": "^2.0.8",
    "qs": "6.16.0",
    "rollup": "^4.59.0",
    "smol-toml": "^1.8.1",
    "source-map-js": "^1.2.2",
    "tmp": "0.2.7",
    "undici@^7.0.0": "7.30.1",
    "undici@^8.0.0": "8.12.3",
    "uuid": "11.1.1",
    "test-exclude": {
      "minimatch": "3.1.5"
    },
    "glob@7.2.3": {
      "minimatch": "3.1.5"
    },
    "readdir-glob": {
      "minimatch": "5.1.9"
    },
    "@sentry/node": {
      "minimatch": "10.2.5"
    },
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "knip": "^6.15.0",
    "yaml": "^2.9.0"
  }
}
